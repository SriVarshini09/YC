  "summary": "Shopify removes the metafieldInteger collection condition in API version 2027-01",
  "details": "As of Admin API version 2027-01, the metafieldInteger collection source condition inputs and types are removed and replaced by metafieldInt, whose value is a String instead of an Int.\n\nBefore moving to 2027-01, replace metafieldInteger with metafieldInt in collection condition inputs and reads (CollectionSourceInclusionConditionMetafieldInt), and send the value as a String.",
  "affected": [
    {
      "ecosystem_specific": {
        "provider": "shopify",
        "endpoint": {
          "method": "POST",
          "path": "/admin/api/{version}/graphql.json"
        },
        "change_class": "field-rename",
        "trigger": {
          "graphql": [
            {
              "field": "metafieldInteger"
            },
            {
              "field": "CollectionSourceInclusionConditionMetafieldInteger"
            },
            {
              "field": "CollectionSourceInclusionConditionMetafieldIntegerRelation"
            }
          ]
        },
        "effective_date": "2027-01-01"
      }
    }
  ],
