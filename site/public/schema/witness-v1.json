{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shapi.dev/schema/witness-v1.json",
  "title": "SHAPI shape witness",
  "description": "One value-free record of one HTTP response from a third-party API: its status, contract headers, deprecation dates and the typed key paths of its body. See https://shapi.dev.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "https://shapi.dev/schema/witness-v1.json"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "apiVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "method": {
      "type": "string",
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "HEAD",
        "OPTIONS"
      ]
    },
    "pathTemplate": {
      "type": "string",
      "format": "starts_with",
      "pattern": "^\\/.*"
    },
    "status": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "headerNames": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deprecation": {
      "type": [
        "string",
        "null"
      ]
    },
    "sunset": {
      "type": [
        "string",
        "null"
      ]
    },
    "body": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "empty",
            "json",
            "text"
          ]
        },
        "fields": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "fields"
      ]
    },
    "mapCollapsed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dropped": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "source": {
      "type": "string",
      "enum": [
        "canary",
        "replay",
        "fixture",
        "fleet"
      ]
    },
    "shapeId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema",
    "provider",
    "apiVersion",
    "method",
    "pathTemplate",
    "status",
    "headerNames",
    "deprecation",
    "sunset",
    "body",
    "mapCollapsed",
    "dropped",
    "observedAt",
    "source",
    "shapeId"
  ]
}
