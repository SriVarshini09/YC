{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shapi.dev/schema/advisory.json",
  "title": "SHAPI advisory",
  "description": "One third-party API change SHAPI checks code against: the endpoint, what changed, what code it breaks, and when. Advisories live at https://github.com/SriVarshini09/shapi-advisories.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "provider": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "endpoint": {
      "type": "object",
      "properties": {
        "method": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "GET",
                "POST",
                "PUT",
                "PATCH",
                "DELETE",
                "HEAD",
                "OPTIONS"
              ]
            },
            {
              "type": "string",
              "const": "*"
            }
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^\\/"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "method",
        "path"
      ]
    },
    "changeClass": {
      "type": "string",
      "enum": [
        "status-code",
        "field-rename",
        "enum-added",
        "required-field",
        "version-sunset",
        "scope-change",
        "auth"
      ]
    },
    "trigger": {
      "type": "object",
      "properties": {
        "statusCodes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "newStatusCodes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "enums": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string"
              },
              "values": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "field"
            ]
          }
        },
        "headers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "query": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "below": {
                "type": "number"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "body": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1
              },
              "values": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "field"
            ]
          }
        },
        "graphql": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1
              },
              "operation": {
                "type": "string",
                "enum": [
                  "query",
                  "mutation",
                  "subscription"
                ]
              }
            },
            "required": [
              "field"
            ]
          }
        },
        "any": {
          "type": "boolean"
        }
      },
      "anyOf": [
        {
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "const": true
            }
          }
        },
        {
          "required": [
            "statusCodes"
          ],
          "properties": {
            "statusCodes": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "fields"
          ],
          "properties": {
            "fields": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "enums"
          ],
          "properties": {
            "enums": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "headers"
          ],
          "properties": {
            "headers": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "query"
          ],
          "properties": {
            "query": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "body"
          ],
          "properties": {
            "body": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "graphql"
          ],
          "properties": {
            "graphql": {
              "type": "array",
              "minItems": 1
            }
          }
        }
      ]
    },
    "firstObserved": {
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "publishedNotice": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "date": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "date",
            "url"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "effectiveDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "migrationNote": {
      "type": "string",
      "minLength": 1
    },
    "recipeId": {
      "type": "string"
    },
    "fix": {
      "type": "object",
      "properties": {
        "path": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "minLength": 1
            },
            "to": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "from",
            "to"
          ]
        },
        "query": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "value"
          ]
        },
        "header": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "value"
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "from",
              "to"
            ]
          }
        },
        "enums": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1
              },
              "values": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string"
                    },
                    "to": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "from",
                    "to"
                  ]
                }
              }
            },
            "required": [
              "field",
              "values"
            ]
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "query"
          ]
        },
        {
          "required": [
            "header"
          ]
        },
        {
          "required": [
            "fields"
          ]
        },
        {
          "required": [
            "enums"
          ]
        }
      ]
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "verified",
        "unverified"
      ]
    },
    "evidence": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "before": {
          "type": "object",
          "properties": {
            "observedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "status": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "shapeHash": {
              "type": "string"
            }
          },
          "required": [
            "observedAt",
            "status",
            "shapeHash"
          ]
        },
        "after": {
          "type": "object",
          "properties": {
            "observedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "status": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "shapeHash": {
              "type": "string"
            }
          },
          "required": [
            "observedAt",
            "status",
            "shapeHash"
          ]
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "source",
        "before",
        "after",
        "changes"
      ]
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "fetchedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "url",
          "quote",
          "sourceSha256",
          "fetchedAt"
        ]
      }
    }
  },
  "required": [
    "id",
    "provider",
    "title",
    "summary",
    "endpoint",
    "changeClass",
    "trigger",
    "firstObserved",
    "publishedNotice",
    "effectiveDate",
    "severity",
    "migrationNote",
    "sources",
    "status"
  ]
}
