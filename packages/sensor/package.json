{
  "name": "@shapi/sensor",
  "version": "0.1.0",
  "private": true,
  "description": "Opt-in add-on that records value-free response shapes of known third-party API calls (Node and Python)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "endpoints": "node ../../scripts/run-ts.mjs scripts/endpoints.ts"
  },
  "devDependencies": {
    "@shapi/core": "workspace:*"
  }
}
