{
  "name": "@shapi/github-app",
  "version": "0.1.0",
  "description": "SHAPI on GitHub: the GitHub App (auth, webhooks, check runs, redelivery) and fix pull requests",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean"
  },
  "dependencies": {
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.1",
    "@shapi/core": "workspace:*",
    "@shapi/repair": "workspace:*"
  }
}
