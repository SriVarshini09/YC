{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "lockfileVersion": {
      "type": "number",
      "const": 1
    },
    "generator": {
      "type": "string"
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "callSites": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "declaredBy": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "callSites",
          "declaredBy"
        ],
        "additionalProperties": false
      }
    },
    "callSites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{12}$"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "column": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "http",
              "sdk"
            ]
          },
          "client": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "method": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "GET",
                  "POST",
                  "PUT",
                  "PATCH",
                  "DELETE",
                  "HEAD",
                  "OPTIONS"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "host": {
            "type": [
              "string",
              "null"
            ]
          },
          "endpoint": {
            "type": [
              "string",
              "null"
            ]
          },
          "resolved": {
            "type": "boolean"
          },
          "surface": {
            "type": "object",
            "properties": {
              "fields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "statusCodes": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "checksOk": {
                "type": "boolean"
              },
              "enums": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "field",
                    "values"
                  ],
                  "additionalProperties": false
                }
              },
              "headers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "value": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "value"
                  ],
                  "additionalProperties": false
                }
              },
              "query": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "value": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "value"
                  ],
                  "additionalProperties": false
                }
              },
              "responseHeaders": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "fields",
              "statusCodes",
              "checksOk",
              "enums",
              "headers",
              "query",
              "responseHeaders"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "file",
          "line",
          "column",
          "provider",
          "kind",
          "client",
          "method",
          "host",
          "endpoint",
          "resolved",
          "surface"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "lockfileVersion",
    "generator",
    "providers",
    "callSites"
  ],
  "additionalProperties": false
}
