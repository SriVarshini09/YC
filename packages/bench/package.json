{
  "name": "@shapi/bench",
  "version": "0.1.0",
  "private": true,
  "description": "APIBreak-Replay: replays real third-party API breakages to measure what SHAPI catches",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "bench:build": "node ../../scripts/run-ts.mjs scripts/build.ts",
    "bench:run": "node ../../scripts/run-ts.mjs scripts/run.ts",
    "bench:okapi": "node ../../scripts/run-ts.mjs scripts/okapi.ts",
    "bench:archive": "node ../../scripts/run-ts.mjs scripts/archive.ts",
    "bench:spec-replay": "node ../../scripts/run-ts.mjs scripts/spec-replay.ts",
    "bench:spec-replay:github": "node ../../scripts/run-ts.mjs scripts/spec-replay-github.ts",
    "bench:spec-replay:twilio": "node ../../scripts/run-ts.mjs scripts/spec-replay-twilio.ts",
    "bench:spec-replay:openai": "node ../../scripts/run-ts.mjs scripts/spec-replay-openai.ts",
    "bench:wayback": "node ../../scripts/run-ts.mjs scripts/wayback.ts",
    "bench:provenance": "node ../../scripts/run-ts.mjs scripts/provenance.ts",
    "bench:leaderboard": "node ../../scripts/run-ts.mjs scripts/leaderboard.ts",
    "bench:baseline-grep": "node ../../scripts/run-ts.mjs scripts/baseline-grep.ts",
    "bench:claude-code": "node ../../scripts/run-ts.mjs scripts/claude-code.ts",
    "bench:canary-backtest": "node ../../scripts/run-ts.mjs scripts/canary-backtest.ts",
    "bench:stripe-coverage": "node ../../scripts/run-ts.mjs scripts/stripe-coverage.ts",
    "bench:shopify-coverage": "node ../../scripts/run-ts.mjs scripts/shopify-coverage.ts",
    "bench:console": "node ../../scripts/run-ts.mjs scripts/provider-console.ts",
    "bench:console-corpus": "node ../../scripts/run-ts.mjs scripts/console-corpus.ts",
    "bench:spec-churn": "node ../../scripts/run-ts.mjs scripts/spec-churn.ts",
    "bench:spec-excerpts": "node ../../scripts/run-ts.mjs scripts/spec-excerpts.ts"
  },
  "dependencies": {
    "@shapi/canary": "workspace:*",
    "@shapi/core": "workspace:*",
    "@shapi/extractor": "workspace:*",
    "@shapi/shapes": "workspace:*"
  },
  "devDependencies": {
    "@shapi/repair": "workspace:*",
    "@shapi/sandbox": "workspace:*",
    "@types/js-yaml": "4.0.9",
    "e2b": "2.52.1",
    "js-yaml": "4.1.0"
  }
}
