{
  "name": "@shapi/canary",
  "version": "0.1.0",
  "description": "Canary workers that probe provider APIs and record response shapes",
  "type": "module",
  "bin": {
    "shapi-canary": "bin/shapi-canary.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["bin", "dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean"
  },
  "dependencies": {
    "@shapi/core": "workspace:*",
    "@shapi/shapes": "workspace:*",
    "commander": "^15.0.0"
  }
}
