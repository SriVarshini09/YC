{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shapi/*": ["packages/*/src/index.ts"],
      "shapi": ["packages/cli/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "packages/*/test", "vitest.config.ts"],
  "exclude": ["**/dist", "**/test/fixtures", "fixtures"]
}
