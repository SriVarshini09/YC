{
  "name": "@shapi/server",
  "version": "0.1.0",
  "private": true,
  "description": "SHAPI's hosted service: web process (API, webhooks) and worker process (jobs)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/web.ts src/worker.ts src/migrate.ts src/register.ts --format esm --dts --clean",
    "start:web": "node dist/web.js",
    "start:worker": "node dist/worker.js",
    "migrate": "node dist/migrate.js",
    "github:register": "node dist/register.js",
    "dev": "node ../../scripts/run-ts.mjs scripts/dev.ts",
    "preview": "node ../../scripts/run-ts.mjs scripts/preview.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/formbody": "^9.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/instrument-serif": "5.2.8",
    "@octokit/rest": "^22.0.1",
    "@sentry/node": "^11.8.0",
    "@shapi/canary": "workspace:*",
    "@shapi/core": "workspace:*",
    "@shapi/db": "workspace:*",
    "@shapi/extractor": "workspace:*",
    "@shapi/github-app": "workspace:*",
    "@shapi/repair": "workspace:*",
    "@shapi/sandbox": "workspace:*",
    "@shapi/shapes": "workspace:*",
    "diff": "9.0.0",
    "fastify": "^5.12.7",
    "kysely": "^0.29.7",
    "pg-boss": "^12.38.0",
    "stripe": "22.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "smee-client": "5.0.0"
  }
}
