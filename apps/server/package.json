{
  "name": "@shapi/server",
  "version": "0.1.0",
  "private": true,
  "description": "SHAPI's hosted service: web process (API, webhooks) and worker process (jobs)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/web.ts src/worker.ts src/migrate.ts --format esm --dts --clean",
    "start:web": "node dist/web.js",
    "start:worker": "node dist/worker.js",
    "migrate": "node dist/migrate.js"
  },
  "dependencies": {
    "@sentry/node": "^11.8.0",
    "@shapi/canary": "workspace:*",
    "@shapi/core": "workspace:*",
    "@shapi/db": "workspace:*",
    "@shapi/shapes": "workspace:*",
    "fastify": "^5.12.7",
    "pg-boss": "^12.38.0",
    "zod": "^4.6.7"
  }
}
