{
  "name": "shapi-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "^22.14.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "pnpm -r build",
    "canary": "shapi-canary",
    "pack:cli": "node scripts/run-ts.mjs packages/cli/scripts/build-npm.ts && node scripts/run-ts.mjs packages/cli/scripts/smoke-npm.ts",
    "advisories:pull": "node scripts/run-ts.mjs packages/cli/scripts/pull-advisories.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@shapi/canary": "workspace:*",
    "@types/node": "^22.20.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^10.13.0",
    "shapi": "workspace:*",
    "tar": "^7.5.22",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
